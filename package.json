{
  "name": "chatledger",
  "version": "0.6.0",
  "description": "Open a WhatsApp chat export on your own computer and see everything that happened in it.",
  "license": "GPL-3.0-or-later",
  "author": "abel0x",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/abel0x/chatledger.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --open",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=firefox",
    "screenshots": "playwright test --project=screenshots",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.24.0",
    "pdfjs-dist": "6.4.299"
  }
}
